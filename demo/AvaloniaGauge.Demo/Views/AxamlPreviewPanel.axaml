<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AvaloniaGauge.Demo.Views.AxamlPreviewPanel"
    xmlns:vm="using:AvaloniaGauge.Demo.ViewModels"
    x:DataType="vm:MainWindowViewModel">

    <GroupBox Header="AXAML">

        <Grid RowDefinitions="*,Auto">

            <TextBox
                Grid.Row="0"
                Text="{Binding GeneratedAxaml}"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                FontFamily="Cascadia Mono"
                FontSize="13"
                Padding="10"/>

            <Button
                Grid.Row="1"
                Content="Copy AXAML"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"/>
                <!--Command="{Binding CopyAxamlCommand}" />-->

        </Grid>

    </GroupBox>

</UserControl>