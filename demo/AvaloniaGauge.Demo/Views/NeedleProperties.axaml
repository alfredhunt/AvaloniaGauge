<UserControl
    x:Class="AvaloniaGauge.Demo.Views.NeedleProperties"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AvaloniaGauge.Demo.ViewModels"
    x:DataType="vm:MainWindowViewModel">

    <GroupBox Header="Needle">
        <Grid
            Margin="10"
            ColumnDefinitions="*,150"
            RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="8">

            <!-- Row 0 -->

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Thickness" />

            <NumericUpDown
                Grid.Row="0"
                Grid.Column="1"
                Value="{Binding NeedleThickness}"
                Minimum="0.5"
                Maximum="20"
                Increment="0.5" />

            <!-- Row 1 -->

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Length" />

            <NumericUpDown
                Grid.Row="1"
                Grid.Column="1"
                Value="{Binding NeedleLength}"
                Minimum="0"
                Maximum="1"
                Increment="0.05" />

            <!-- Row 2 -->

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Tail Length" />

            <NumericUpDown
                Grid.Row="2"
                Grid.Column="1"
                Value="{Binding NeedleTailLength}"
                Minimum="0"
                Maximum="1"
                Increment="0.05" />

            <!-- Row 3 -->

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Center Radius" />

            <NumericUpDown
                Grid.Row="3"
                Grid.Column="1"
                Value="{Binding NeedleCenterRadius}"
                Minimum="0"
                Maximum="30"
                Increment="1" />

        </Grid>
    </GroupBox>

</UserControl>